# ============================================================================
# VIDNOVA PLATFORM - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' on your production server:
#      cp .env.production.example .env
# 2. Populate all required secrets using AWS Secrets Manager, HashiCorp Vault,
#    or secure CI/CD pipeline variables.
# 3. DO NOT commit actual secrets or production keys into version control.

# ============================================================================
# 1. APPLICATION & SECURITY (REQUIRED)
# ============================================================================
ENVIRONMENT=production
APP_TITLE=VIDNOVA AI Video Translation & Understanding Platform
JWT_SECRET_KEY=generate_a_64_character_hex_or_base64_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# CORS Allowed Origins (Comma-separated production domains)
CORS_ORIGINS=https://vidnova.ai,https://app.vidnova.ai,https://api.vidnova.ai

# ============================================================================
# 2. HIGH-AVAILABILITY OBJECT STORAGE (AWS S3 PRIMARY + MINIO FALLBACK)
# ============================================================================
# Storage Mode: "s3" for Production AWS S3 Primary with MinIO Fallback
STORAGE_MODE=s3

# Primary Cloud Storage: AWS S3
# Provision an IAM Role or IAM User with least-privilege S3 Policy on the bucket.
AWS_ACCESS_KEY_ID=AKIA_YOUR_PRODUCTION_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_PRODUCTION_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=vidnova-media-prod
AWS_S3_ENDPOINT_URL=

# Fallback Object Storage: MinIO (Disaster Recovery & Local Container Fallback)
# Activated automatically via Circuit Breaker if AWS S3 experiences outages or timeouts.
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=https://storage.vidnova.ai
MINIO_ACCESS_KEY=generate_minio_service_account_access_key
MINIO_SECRET_KEY=generate_minio_service_account_secret_key
MINIO_BUCKET=vidnova-media-fallback
MINIO_REGION=ap-southeast-1

# Storage Circuit Breaker Policy
STORAGE_CIRCUIT_BREAKER_ENABLED=true
STORAGE_FAILURE_THRESHOLD=3
STORAGE_RECOVERY_TIMEOUT_SECONDS=60

# ============================================================================
# 3. DATABASE (POSTGRESQL 16 PRODUCTION)
# ============================================================================
# Use Amazon RDS / Aurora PostgreSQL or managed clustered PostgreSQL instance.
DATABASE_URL=postgresql://vidnova_db_user:YOUR_STRONG_DB_PASSWORD@db:5432/ai_video
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ============================================================================
# 4. REDIS (CELERY BROKER & CACHE STORE)
# ============================================================================
# Use Amazon ElastiCache for Redis or secure standalone Redis cluster.
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0

# ============================================================================
# 5. PAYMENT GATEWAY (VNPAY PRODUCTION)
# ============================================================================
VNPAY_TMN_CODE=YOUR_OFFICIAL_VNPAY_MERCHANT_CODE
VNPAY_HASH_SECRET=YOUR_OFFICIAL_VNPAY_HASH_SECRET
VNPAY_URL=https://pay.vnpay.vn/vpcpay.html
VNPAY_RETURN_URL=https://app.vidnova.ai/payments/vnpay/return
VNPAY_EXCHANGE_RATE_USD_VND=25000

# ============================================================================
# 6. AI & MACHINE LEARNING INFERENCE
# ============================================================================
# Hugging Face Access Token (Required for gated models such as PyAnnote Diarization)
HF_TOKEN=hf_your_production_huggingface_token
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
TRANSLATION_BACKEND=nllb
TTS_API_URL=http://tts-service:8001/generate_tts
SEGMENT_SECONDS=5

# Groq Cloud Whisper API Fallback (Optional fallback when local CPU/GPU is overloaded)
GROQ_API_KEY=gsk_your_groq_api_fallback_key

# ============================================================================
# 7. EMAIL DELIVERY & GOOGLE OAUTH2
# ============================================================================
SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SMTP_PORT=587
MAIL_FROM=no-reply@vidnova.ai
SMTP_USER=YOUR_AWS_SES_SMTP_USERNAME
SMTP_PASSWORD=YOUR_AWS_SES_SMTP_PASSWORD

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=

# ============================================================================
# 8. FRONTEND CLIENT CONFIGURATION
# ============================================================================
VITE_API_BASE_URL=https://api.vidnova.ai
VITE_S3_BUCKET_URL=https://vidnova-media-prod.s3.ap-southeast-1.amazonaws.com
VITE_FALLBACK_STORAGE_URL=https://storage.vidnova.ai
