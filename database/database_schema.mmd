    users ||--o{ tags : "creates"
    users ||--o{ video_comments : "writes"

    users ||--o{ user_subscriptions : "subscribes_to"
    plans ||--o{ user_subscriptions : "assigned_in"
    plans ||--o{ plan_resources : "defines_limits_and_features"

    users ||--o{ user_storage_addons : "purchases"
    storage_addons ||--o{ user_storage_addons : "provides_storage"

    users ||--o{ user_consumable_usage : "consumes_credits"

    projects ||--o{ project_tags : "tagged_with"
    tags ||--o{ project_tags : "categorizes"
    projects ||--o{ project_glossary : "contains"
    projects ||--o{ videos : "manages"
    projects ||--o{ activity_logs : "associated_with"

    videos ||--o{ speaker_profiles : "identifies"
    videos ||--o{ transcript_segments : "transcribes_into"
    speaker_profiles ||--o{ transcript_segments : "speaks_in"
    transcript_segments ||--o{ translation_segments : "translates_into"
    translation_segments ||--o{ subtitle_segments : "formats_as_subtitles"
    videos ||--o{ video_comments : "receives_feedback_on"
