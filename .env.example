# ============================================================================
# VIDNOVA PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Huong dan: Sao chep file nay thanh '.env':
#   cp .env.example .env   (hoac copy .env.example sang .env)
# Cac gia tri mac dinh ben duoi da duoc cau hinh de chay ngay lap tuc
# voi MinIO va VNPay Sandbox ma KHONG CAN dang ky tai khoan ben ngoai.

# ============================================================================
# 1. SECURITY & AUTHENTICATION (BAT BUOC)
# ============================================================================
JWT_SECRET_KEY=Kimchidoao_change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# ============================================================================
# 2. DATABASE (POSTGRESQL 16)
# ============================================================================
DATABASE_URL=postgresql://ai_video:ai_video@db:5432/ai_video

# ============================================================================
# 3. STORAGE: S3 / MINIO (OBJECT STORAGE)
# ============================================================================
# [CHON CHE DO LUU TRU / STORAGE MODE]:
# STORAGE_MODE=minio  -> Chay truc tiep bang MinIO (Local Dev / Test, khong can AWS)
# STORAGE_MODE=s3     -> Chay bang AWS S3 that (Production Cloud, co MinIO fallback)
# STORAGE_MODE=auto   -> Tu dong nhan dien (Mac dinh: MinIO khi dev, S3 khi deploy prod)
STORAGE_MODE=minio

# [CAU HINH MINIO CHO DEV]:
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=vidnova-videos
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
# MinIO Console Web UI tren trinh duyet: http://localhost:9001
# Tai khoan: minioadmin / minioadmin

# [KHI DUNG AWS S3 THAT TRONG TUONG LAI]:
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=your-production-bucket-name
# S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com

# ============================================================================
# 4. REDIS (CELERY TASK QUEUE & CACHE)
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# 5. PAYMENT GATEWAY (VNPAY)
# ============================================================================
# Mac dinh ben duoi la tai khoan Sandbox test mien phi cua VNPay.
# Ban co the test thanh toan ngay lap tuc ma khong can dang ky voi VNPay.
VNPAY_TMN_CODE=K742YGYA
VNPAY_HASH_SECRET=NPVWUJBAUQGZUGYLXRSOQBJYCTWSYMBA
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payments/vnpay/return
VNPAY_EXCHANGE_RATE_USD_VND=25000

# ============================================================================
# 6. AI & MACHINE LEARNING CONFIGURATION
# ============================================================================
# Hugging Face Token (Tuy chon - chi can neu tai model rieng pyannote):
HF_TOKEN=
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
TRANSLATION_BACKEND=nllb
TTS_API_URL=http://tts-service:8001/generate_tts
SEGMENT_SECONDS=5

# ============================================================================
# 7. EMAIL & GOOGLE OAUTH2 (TUY CHON)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ============================================================================
# 8. FRONTEND URLS (CLIENT)
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_S3_BUCKET_URL=http://localhost:9000
VITE_MINIO_ENDPOINT=http://localhost:9000
