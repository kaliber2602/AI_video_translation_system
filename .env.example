# =========================================================
# 1. VNPAY PAYMENT GATEWAY (SANDBOX & PRODUCTION)
# =========================================================
# Mã định danh website (Terminal ID) do VNPay cung cấp qua email
VNPAY_TMN_CODE=your_vnpay_tmn_code_here

# Chuỗi bí mật dùng để tạo và xác thực chữ ký bảo mật HMAC-SHA512
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here

# URL cổng thanh toán Sandbox của VNPay
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# URL nhận kết quả thanh toán trả về trên Frontend sau khi thanh toán xong
VNPAY_RETURN_URL=http://localhost:5173/payments/vnpay/return

# Tỷ giá quy đổi USD sang VND (vì giá gói hệ thống tính bằng USD, VNPay nhận VND)
VNPAY_EXCHANGE_RATE_USD_VND=25000


# =========================================================
# 2. STRIPE PAYMENT GATEWAY (GLOBAL CARDS)
# =========================================================
# Khóa bí mật Stripe (Secret Key - bắt đầu bằng sk_test_... hoặc sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Khóa công khai Stripe (Publishable Key - bắt đầu bằng pk_test_... hoặc pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# URL nhận kết quả sau khi hoàn tất thanh toán trên Stripe Checkout
STRIPE_SUCCESS_URL=http://localhost:5173/payments/stripe/return?session_id={CHECKOUT_SESSION_ID}&txn={TXN_CODE}
STRIPE_CANCEL_URL=http://localhost:5173/pricing


# =========================================================
# 2. JWT & AUTHENTICATION SECURITY
# =========================================================
# Chuỗi khóa bí mật dùng để ký và giải mã JWT token (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_characters_long

# Thuật toán mã hóa chữ ký JWT (mặc định: HS256)
JWT_ALGORITHM=HS256

# Thời gian sống của Access Token tính bằng phút (mặc định: 30 phút)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Thời gian sống của Refresh Token tính bằng ngày (mặc định: 7 ngày)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Thời gian hiệu lực của mã OTP gửi qua email tính bằng phút (mặc định: 10 phút)
OTP_EXPIRE_MINUTES=10


# =========================================================
# 3. DATABASE & STORAGE
# =========================================================
# Chuỗi kết nối PostgreSQL (Docker nội bộ dùng host 'db', chạy máy local dùng 'localhost')
DATABASE_URL=postgresql://ai_video:ai_video@db:5432/ai_video
POSTGRES_DB=ai_video
POSTGRES_USER=ai_video
POSTGRES_PASSWORD=ai_video

# MinIO Object Storage (S3-compatible lưu trữ video/âm thanh)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# =========================================================
# 4. EMAIL SERVICE (GMAIL OAUTH2 / SMTP)
# =========================================================
# Địa chỉ email hệ thống dùng để gửi thư xác thực / OTP cho người dùng
MAIL_FROM=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Google OAuth2 Credentials để gửi email qua Gmail API an toàn
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token


# =========================================================
# 5. AI PIPELINE & MODEL SERVICES
# =========================================================
# Kích thước mô hình Speech-to-Text Faster-Whisper (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small

# Thiết bị chạy Whisper: 'cpu' hoặc 'cuda' (nếu có card NVIDIA GPU)
WHISPER_DEVICE=cpu

# Backend dịch thuật AI: 'nllb' (Facebook NLLB-200) hoặc 'google'
TRANSLATION_BACKEND=nllb

# URL của container TTS (Text-To-Speech / Coqui XTTS)
TTS_API_URL=http://tts-service:8001/generate_tts

# HuggingFace Token (nếu cần tải các mô hình yêu cầu cấp phép)
HF_TOKEN=
