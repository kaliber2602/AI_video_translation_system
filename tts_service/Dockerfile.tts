FROM python:3.10-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng build-essential && rm -rf /var/lib/apt/lists/*
COPY requirements-tts.txt .
RUN pip install --no-cache-dir -r requirements-tts.txt
COPY tts_server.py .
CMD ["uvicorn", "tts_server:app", "--host", "0.0.0.0", "--port", "8001"]