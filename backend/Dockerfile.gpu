FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    git \
    libsndfile1 \
    libgl1 \
    libglib2.0-0 \
    espeak-ng \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-gpu.txt ./

# Install PyTorch with CUDA 12.4
RUN pip install --no-cache-dir \
    torch==2.5.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124 && \
    pip install --no-cache-dir \
    --default-timeout=120 \
    --retries 5 \
    -r requirements-gpu.txt

COPY . ./

ENV COQUI_TOS_AGREED=1 \
    WHISPER_MODEL=small \
    WHISPER_DEVICE=cuda \
    WHISPER_COMPUTE_TYPE=int8_float16 \
    TRANSLATION_BACKEND=nllb \
    TRANSLATION_DEVICE=cuda \
    HF_HOME=/opt/model-cache/hf

CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--pool=solo", "--loglevel=info"]
